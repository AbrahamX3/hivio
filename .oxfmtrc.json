{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"indentStyle": "space",
	"indentWidth": 2,
	"lineWidth": 80,
	"sortTailwind": true,
	"sortImports": true,
	"useTabs": true,
	"printWidth": 80,
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"proseWrap": "always",
	"tabWidth": 2
}
